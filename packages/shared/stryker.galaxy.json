{
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "testFiles": ["src/galaxy-creation/createGalaxy.test.ts"],
  "mutate": [
    "src/galaxy-creation/**/*.ts",
    "!src/galaxy-creation/**/*.test.ts",
    "!src/galaxy-creation/**/*.stub.ts",
    "!src/galaxy-creation/scripts/**"
  ],
  "ignorePatterns": ["tsconfig*.json"],
  "concurrency": 4,
  "reporters": ["clear-text", "html", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/galaxy.json"
  }
}

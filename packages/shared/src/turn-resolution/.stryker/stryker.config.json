{
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": ".stryker/vitest.stryker.config.ts"
  },
  "testFiles": ["**/*.test.ts"],
  "mutate": ["**/*.ts", "!**/*.test.ts", "!**/*.stub.ts", "!**/*.mock.ts", "!**/*.d.ts", "!.stryker/**"],
  "tempDirName": ".stryker/sandboxes",
  "concurrency": 4,
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": {
    "fileName": ".stryker/reports/mutation.html"
  },
  "jsonReporter": {
    "fileName": ".stryker/reports/mutation.json"
  }
}

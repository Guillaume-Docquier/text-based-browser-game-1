{
  "name": "shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/*"
  },
  "exports": {
    "./domain/*": "./src/domain/*",
    "./galaxy-creation/*": "./src/galaxy-creation/*",
    "./turn-resolution/*": "./src/turn-resolution/*",
    "./testing/*": "./src/testing/*"
  },
  "scripts": {
    "mutation:galaxy-creation": "cd src/galaxy-creation && stryker run .stryker/stryker.config.json",
    "mutation:turn-resolution": "cd src/turn-resolution && stryker run .stryker/stryker.config.json",
    "test": "vitest run",
    "test:coverage": "pnpm test --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@guillaume-docquier/tools-ts": "catalog:",
    "decimal.js": "^10.6.0",
    "transformation-matrix": "^3.1.0",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "catalog:",
    "commander": "^15.1.0",
    "fast-check": "^4.11.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

# Authentication — shared by the backend, browser app, and Playwright
CLERK_PUBLISHABLE_KEY=
# Same as CLERK_PUBLISHABLE_KEY, but Vite requires the VITE_ prefix
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres — Docker Compose setup
POSTGRES_PORT="5432"
COMPOSE_PROJECT_NAME="cosmic-empires-main"

# Backend — local API server and PostgreSQL
PORT=3000
DATABASE_URL=postgres://user:pwd@localhost:5432/cosmic-empires

# Frontend — Vite development server and API proxy
VITE_DEV_PORT=5173
# Local HTTP uses IPv4 loopback; see docs/architecture/decisions/032-use-explicit-ipv4-loopback-for-local-services.md
VITE_BACKEND_HOST=http://127.0.0.1:3000
VITE_BACKEND_BASE_URL=/api

# Database seeding — optional local account; uncomment and fill all three to add yourself
# CLERK_ID=
# USER_ALIAS=
# USER_EMAIL=

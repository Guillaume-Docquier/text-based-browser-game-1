{
  "name": "text-based-browser-game-1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "checks": "pnpm lint:fix && pnpm format:fix && pnpm -r checks",
    "db:reset": "docker compose -f infra/docker-compose.yaml down --volumes && docker compose -f infra/docker-compose.yaml up --wait db && pnpm --filter backend db:migrate && pnpm --filter backend db:seed",
    "format": "prettier --check . && pnpm format:package-json --check",
    "format:fix": "prettier --write --list-different . && pnpm format:package-json",
    "format:package-json": "sort-package-json package.json shared/eslint/package.json frontend/package.json backend/package.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepare": "husky",
    "wts": "pnpm i && cp ../text-based-browser-game-1/backend/.env backend/.env && cp ../text-based-browser-game-1/frontend/.env frontend/.env"
  },
  "lint-staged": {
    "*package.json": "sort-package-json",
    "*.{md,json,yml,yaml,css,scss}": "prettier --write",
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 140,
    "semi": false
  },
  "devDependencies": {
    "@shared/eslint": "workspace:*",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "sort-package-json": "3.6.1"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}

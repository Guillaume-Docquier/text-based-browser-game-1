{
  "name": "text-based-browser-game-1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "checks": "pnpm lint:fix && pnpm format:fix && pnpm -r checks",
    "format": "prettier --check . && pnpm format:package-json --check",
    "format:fix": "prettier --write --list-different . && pnpm format:package-json",
    "format:package-json": "sort-package-json package.json shared/eslint/package.json frontend/package.json backend/package.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepare": "husky",
    "wts": "pnpm i && cp ../text-based-browser-game-1/backend/.env backend/.env && cp ../text-based-browser-game-1/frontend/.env frontend/.env"
  },
  "lint-staged": {
    "*package.json": "sort-package-json",
    "*.{md,json,yml,yaml,css,scss}": "prettier --write",
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 140,
    "semi": false
  },
  "devDependencies": {
    "@shared/eslint": "workspace:*",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "sort-package-json": "3.6.1"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}

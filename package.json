{
  "name": "text-based-browser-game-1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bta": "pnpm --filter backend test",
    "btc": "pnpm --filter backend test --project concurrency",
    "bti": "pnpm --filter backend test --project integration",
    "containers:prune": "docker container prune -f --filter label=dev.cleanup=true --filter until=168h",
    "db:clean": "pnpm db:remove && pnpm db:up && pnpm --filter backend db:migrate && pnpm --filter backend db:seed",
    "db:compose": "docker compose --env-file .env -f infra/docker-compose.yaml",
    "db:nuke": "rm -rf packages/backend/drizzle && pnpm --filter backend db:generate --name init && pnpm --filter backend db:sync-custom && pnpm db:clean",
    "db:remove": "pnpm db:compose down --volumes",
    "db:up": "pnpm db:compose up --wait db",
    "dev:cert": "mkcert -install && mkcert -cert-file packages/frontend/.dev-tls/localhost.pem -key-file packages/frontend/.dev-tls/localhost-key.pem localhost",
    "dev:setup": "pnpm dev:cert && pnpm db:clean",
    "fmt:requirements": "node scripts/format-requirements.ts",
    "fmt:workspace": "oxfmt",
    "format": "pnpm run --sequential \"/^fmt:/\" --check",
    "format:fix": "pnpm run --sequential \"/^fmt:/\" --write",
    "fte": "pnpm --filter frontend e2e",
    "lint": "oxlint",
    "lint:fix": "pnpm lint --fix",
    "map-gen": "node packages/backend/scripts/map-gen/program.ts",
    "map-gen:all": "pnpm map-gen galaxy cluster --grid --seed 1234 && pnpm map-gen galaxy spiral --grid --seed 1234 && pnpm map-gen spiral --seed 1234 && pnpm map-gen cluster --seed 1234",
    "prepare": "husky",
    "storybook": "pnpm --filter frontend storybook",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "wtd": "pnpm db:remove",
    "wts": "node scripts/worktree-setup.ts && pnpm dev:setup"
  },
  "devDependencies": {
    "@guillaume-docquier/oxfmt": "^1.0.22",
    "@guillaume-docquier/oxlint": "^1.11.3",
    "@guillaume-docquier/show-me": "^1.7.1",
    "@types/node": "^26.6.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": ">=0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "railway": "^3.16.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vscode-languageserver-protocol": "^3.18.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}

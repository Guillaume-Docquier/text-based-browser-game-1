{
  "name": "text-based-browser-game-1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bta": "pnpm --filter backend test",
    "btc": "pnpm --filter backend test --project concurrency",
    "bti": "pnpm --filter backend test --project integration",
    "btu": "pnpm --filter backend test --project unit",
    "containers:prune": "docker container prune -f --filter label=dev.cleanup=true --filter until=168h",
    "db:clean": "pnpm db:remove && pnpm db:up && pnpm --filter backend db:migrate && pnpm --filter backend db:seed",
    "db:compose": "docker compose --env-file .env -f infra/docker-compose.yaml",
    "db:nuke": "rm -rf apps/backend/drizzle && pnpm --filter backend db:generate --name init && pnpm db:clean",
    "db:remove": "pnpm db:compose down --volumes",
    "db:up": "pnpm db:compose up --wait db",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "fte": "pnpm --filter frontend e2e",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "map-gen": "node apps/backend/scripts/map-gen/program.ts",
    "map-gen:all": "pnpm map-gen galaxy cluster --grid --seed 1234 && pnpm map-gen galaxy spiral --grid --seed 1234 && pnpm map-gen spiral --seed 1234 && pnpm map-gen cluster --seed 1234",
    "prepare": "husky",
    "storybook": "pnpm --filter frontend storybook",
    "typecheck": "tsc -p tsconfig.json",
    "wts": "node scripts/worktree-setup.ts && pnpm db:clean"
  },
  "devDependencies": {
    "@guillaume-docquier/oxfmt": "^1.0.14",
    "@guillaume-docquier/oxlint": "^1.8.7",
    "@guillaume-docquier/show-me": "^1.7.1",
    "@types/node": "^26.6.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": ">=0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{md,json,yml,yaml,css,html}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "download"
    }
  }
}

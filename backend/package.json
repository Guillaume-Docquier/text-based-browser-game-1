{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./src/api/*",
    "#tick-processing/*": "./src/tick-processing/*",
    "#lib/*": "./src/lib/*",
    "#tests/*": "./src/tests/*"
  },
  "scripts": {
    "checks": "pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:seed": "node --env-file=.env scripts/db/seed.ts",
    "dev": "node --watch --env-file=.env src/api/entry.api.ts",
    "start": "node src/api/entry.api.ts",
    "test": "vitest run --silent",
    "test:coverage": "pnpm test --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@clerk/express": "^2.1.19",
    "@guillaume-docquier/tools-ts": "^2.1.0",
    "@trpc/server": "^11.17.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "p-retry": "^8.0.0",
    "pg": "^8.21.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@inquirer/prompts": "^8.4.3",
    "@trpc/client": "^11.17.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  }
}

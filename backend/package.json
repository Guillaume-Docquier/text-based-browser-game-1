{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./src/api/*",
    "#turn-processing/*": "./src/turn-processing/*",
    "#lib/*": "./src/lib/*",
    "#tests/*": "./src/tests/*"
  },
  "scripts": {
    "checks": "pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:seed": "node --env-file=.env scripts/db/seed.ts",
    "dev": "node --watch --env-file=.env src/api/entry.api.ts",
    "start": "node src/api/entry.api.ts",
    "test": "vitest run --silent",
    "test:coverage": "pnpm test --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "@guillaume-docquier/tools-ts": "catalog:",
    "@trpc/server": "^11.18.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "p-retry": "^8.0.0",
    "pg": "^8.23.0",
    "transformation-matrix": "^3.1.0",
    "utility-types": "^3.11.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@inquirer/prompts": "^8.7.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@trpc/client": "^11.18.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "commander": "^15.0.0",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.1.0",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
